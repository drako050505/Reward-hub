<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GreenCast Pro - Control de Difusión</title>
    
    <!-- Librerías de Interfaz y Lógica (CDNs) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <!-- Firebase Versión Compat -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700;800&display=swap');
        body { 
            font-family: 'JetBrains Mono', monospace; 
            background-color: #09090b; 
            color: #10b981;
        }
        .emerald-glow { box-shadow: 0 0 25px rgba(16, 185, 129, 0.15); }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #000; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #065f46; border-radius: 10px; }
        .animate-flicker { animation: flicker 2s infinite; }
        @keyframes flicker {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        // --- CONFIGURACIÓN DE FIREBASE ---
        const firebaseConfig = {
            apiKey: "AIzaSyB0pJrOhSspQN96oPRiSgZY9ENaiPkD1dw",
            authDomain: "verdegreen-17e9d.firebaseapp.com",
            projectId: "verdegreen-17e9d",
            storageBucket: "verdegreen-17e9d.firebasestorage.app",
            messagingSenderId: "846751594809",
            appId: "1:846751594809:web:ee8b502d5e76cd298ed0e8",
            measurementId: "G-5SNLLVSK65"
        };

        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();
        const db = firebase.firestore();

        const { useState, useEffect, useRef } = React;

        function App() {
            const [user, setUser] = useState(null);
            const [email, setEmail] = useState('');
            const [password, setPassword] = useState('');
            const [contacts, setContacts] = useState([]);
            const [message, setMessage] = useState('');
            const [status, setStatus] = useState('idle');
            const [currentIndex, setCurrentIndex] = useState(0);
            const [timeLeft, setTimeLeft] = useState(0);
            const [logs, setLogs] = useState([]);
            
            // Datos configurados según tus credenciales reales de SmsGateway24
            const [apiToken, setApiToken] = useState('f7881a63680395513b215894ec8577a0');
            const [deviceId, setDeviceId] = useState('12759');
            
            const [myNumber, setMyNumber] = useState('');
            const [interval, setIntervalVal] = useState(1);
            const [testStatus, setTestStatus] = useState('idle');
            
            const timerRef = useRef(null);
            const logEndRef = useRef(null);

            useEffect(() => {
                const unsubscribe = auth.onAuthStateChanged((u) => setUser(u));
                return () => unsubscribe();
            }, []);

            useEffect(() => {
                if (!user) return;
                const unsubscribe = db.collection("users").doc(user.uid).collection("contacts")
                    .onSnapshot((snapshot) => {
                        setContacts(snapshot.docs.map(d => ({ id: d.id, ...d.data() })));
                    });
                return () => unsubscribe();
            }, [user]);

            useEffect(() => {
                if (status === 'sending' && timeLeft > 0) {
                    timerRef.current = setTimeout(() => setTimeLeft(timeLeft - 1), 1000);
                } else if (status === 'sending' && timeLeft === 0) {
                    sendNext();
                }
                return () => clearTimeout(timerRef.current);
            }, [status, timeLeft]);

            const handleLogin = async (e) => {
                e.preventDefault();
                try {
                    await auth.signInWithEmailAndPassword(email, password);
                } catch (err) {
                    alert("Credenciales incorrectas: " + err.message);
                }
            };

            // FUNCIÓN DE ENVÍO CON ENDPOINT ESTABLE
            const sendSMS = async (number, text) => {
                if (!apiToken || !deviceId) return { success: false, error: "Faltan credenciales" };
                
                // Limpieza profunda de número (importante para evitar errores de API)
                const cleanPhone = number.replace(/[^\d+]/g, "");

                try {
                    const formData = new FormData();
                    formData.append('token', apiToken.trim());
                    formData.append('device_id', deviceId.trim());
                    formData.append('phone', cleanPhone);
                    formData.append('msg', text);

                    const res = await fetch('https://smsgateway24.com/getapi/addmessage', {
                        method: 'POST',
                        body: formData
                    });
                    
                    if (!res.ok) {
                        return { success: false, error: `Error de Servidor (${res.status})` };
                    }
                    
                    const data = await res.json();
                    if (data.error === "0" || data.success == "1") {
                        return { success: true };
                    } else {
                        return { success: false, error: data.message || "Fallo API" };
                    }
                } catch (e) {
                    console.error("Error en envío:", e);
                    // Si sigue saliendo BLOQUEO RED en Vercel, es un tema de las cabeceras de SmsGateway24
                    return { success: false, error: "BLOQUEO RED" };
                }
            };

            const handleTestSend = async () => {
                if (!myNumber || !message) return alert("Ingresa un mensaje y tu número de prueba.");
                setTestStatus('sending');
                const result = await sendSMS(myNumber, message);
                
                setLogs(prev => [{
                    id: Date.now(),
                    target: myNumber + " (YO)",
                    status: result.success ? 'RECIBIDO' : result.error,
                    time: new Date().toLocaleTimeString()
                }, ...prev]);
                
                setTestStatus(result.success ? 'success' : 'error');
                setTimeout(() => setTestStatus('idle'), 3000);
            };

            const sendNext = async () => {
                if (currentIndex >= contacts.length) {
                    setStatus('finished');
                    return;
                }
                const contact = contacts[currentIndex];
                const result = await sendSMS(contact.phone, message);
                
                setLogs(prev => [{
                    id: Date.now(),
                    target: contact.phone,
                    status: result.success ? 'OK' : result.error,
                    time: new Date().toLocaleTimeString()
                }, ...prev]);
                
                const nextIdx = currentIndex + 1;
                setCurrentIndex(nextIdx);

                if (nextIdx < contacts.length) {
                    setTimeLeft(interval * 60);
                } else {
                    setStatus('finished');
                }
            };

            const import200 = async () => {
                if (!user) return;
                const batch = db.batch();
                const colRef = db.collection("users").doc(user.uid).collection("contacts");
                for (let i = 1; i <= 200; i++) {
                    const d = colRef.doc();
                    batch.set(d, { 
                        name: `Destinatario ${i}`, 
                        phone: `+1805${Math.floor(1000000 + Math.random()*8999999)}`
                    });
                }
                await batch.commit();
            };

            const clearContacts = async () => {
                if (!user || !confirm("¿Borrar todos los contactos de la lista?")) return;
                const snapshot = await db.collection("users").doc(user.uid).collection("contacts").get();
                const batch = db.batch();
                snapshot.docs.forEach(doc => batch.delete(doc.ref));
                await batch.commit();
                setCurrentIndex(0);
                setLogs([]);
            };

            if (!user) {
                return (
                    <div className="min-h-screen flex items-center justify-center p-4">
                        <div className="bg-zinc-900 p-10 rounded-[2.5rem] border-2 border-emerald-900 w-full max-w-md shadow-2xl emerald-glow text-center">
                            <div className="bg-emerald-600 w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" strokeWidth="3"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            </div>
                            <h2 className="text-white font-black text-3xl tracking-tighter uppercase mb-2">VerdeGreen</h2>
                            <p className="text-emerald-700 text-[10px] font-bold tracking-[0.4em] mb-8 uppercase tracking-widest">Acceso Seguro</p>
                            <form onSubmit={handleLogin} className="space-y-4 text-left">
                                <input type="email" placeholder="Email" className="w-full bg-black border-none rounded-2xl p-4 text-emerald-400 outline-none focus:ring-2 focus:ring-emerald-500" value={email} onChange={e => setEmail(e.target.value)} />
                                <input type="password" placeholder="Contraseña" className="w-full bg-black border-none rounded-2xl p-4 text-emerald-400 outline-none focus:ring-2 focus:ring-emerald-500" value={password} onChange={e => setPassword(e.target.value)} />
                                <button className="w-full bg-emerald-600 hover:bg-emerald-500 text-black font-black py-4 rounded-2xl transition-all uppercase shadow-xl active:scale-95">Desbloquear</button>
                            </form>
                        </div>
                    </div>
                );
            }

            return (
                <div className="min-h-screen flex flex-col">
                    <header className="bg-zinc-900 p-4 border-b border-emerald-900/30 flex justify-between items-center shadow-2xl relative z-20">
                        <div className="flex items-center gap-3">
                            <div className="bg-emerald-600 p-2 rounded shadow-lg animate-flicker">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="black" strokeWidth="3"><path d="m13 2-2 10h3L11 22l2-10h-3l2-10z"/></svg>
                            </div>
                            <span className="font-black text-white tracking-widest text-base uppercase italic tracking-tighter">GreenCast v3.5 PRO</span>
                        </div>
                        <div className="flex items-center gap-4">
                            <span className="text-[10px] text-emerald-900 hidden md:block">CONECTADO: {user.email}</span>
                            <button onClick={() => auth.signOut()} className="text-emerald-900 hover:text-red-500 font-bold text-xs uppercase transition-colors">Cerrar Sesión</button>
                        </div>
                    </header>

                    <div className="flex-1 p-6 max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-6 overflow-hidden">
                        
                        <div className="lg:col-span-4 space-y-6">
                            {/* API CONFIG */}
                            <div className="bg-zinc-900 p-6 rounded-3xl border border-zinc-800 shadow-xl">
                                <h3 className="text-white text-[10px] font-black mb-4 uppercase tracking-widest flex items-center gap-2">
                                    <span className="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span> Configuración API
                                </h3>
                                <div className="space-y-3">
                                    <div className="bg-black p-3 rounded-xl border border-emerald-900/10">
                                        <label className="text-[8px] text-emerald-900 font-bold block mb-1 uppercase tracking-tighter">Token (SmsGateway24)</label>
                                        <input type="password" placeholder="Token..." className="w-full bg-transparent text-[11px] text-emerald-400 outline-none" value={apiToken} onChange={e => setApiToken(e.target.value)} />
                                    </div>
                                    <div className="bg-black p-3 rounded-xl border border-emerald-900/10">
                                        <label className="text-[8px] text-emerald-900 font-bold block mb-1 uppercase tracking-tighter">ID Dispositivo (Samsung)</label>
                                        <input type="text" placeholder="ID..." className="w-full bg-transparent text-[11px] text-emerald-400 outline-none" value={deviceId} onChange={e => setDeviceId(e.target.value)} />
                                    </div>
                                </div>
                            </div>

                            {/* PROBADOR */}
                            <div className="bg-emerald-950/10 p-6 rounded-3xl border border-emerald-500/20 shadow-xl">
                                <h3 className="text-emerald-400 text-[10px] font-black mb-4 uppercase tracking-widest flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l2.27-2.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg> Recibir en mi teléfono
                                </h3>
                                <div className="bg-black p-3 rounded-xl border border-emerald-500/10 mb-3 shadow-inner">
                                    <label className="text-[8px] text-emerald-600 block mb-1 uppercase font-bold">Número (ej: +1...)</label>
                                    <input type="tel" placeholder="+1..." className="w-full bg-transparent text-xs text-white outline-none" value={myNumber} onChange={e => setMyNumber(e.target.value)} />
                                </div>
                                <button onClick={handleTestSend} className={`w-full py-3 rounded-xl text-[10px] font-black uppercase transition-all flex items-center justify-center gap-2 ${testStatus === 'sending' ? 'bg-zinc-800' : testStatus === 'success' ? 'bg-green-600 text-white shadow-[0_0_15px_#16a34a]' : 'bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-500 hover:text-black shadow-lg'}`}>
                                    {testStatus === 'sending' ? 'Transmitiendo...' : 'ENVIAR PRUEBA AHORA'}
                                </button>
                                {testStatus === 'error' && <p className="text-[8px] text-red-500 mt-2 text-center font-bold uppercase tracking-tighter">Error de conexión (CORS / Bloqueo)</p>}
                            </div>

                            {/* AUDIENCIA */}
                            <div className="bg-zinc-900 p-6 rounded-3xl border border-zinc-800 shadow-xl">
                                <div className="flex justify-between items-end mb-3 font-black uppercase text-[10px]">
                                    <span className="text-zinc-500 tracking-widest">En cola</span>
                                    <span className="text-white text-lg tracking-tighter">{currentIndex} / {contacts.length}</span>
                                </div>
                                <div className="w-full bg-black h-2 rounded-full overflow-hidden mb-5 shadow-inner">
                                    <div className="bg-emerald-500 h-full transition-all duration-700 shadow-[0_0_10px_#10b981]" style={{ width: `${contacts.length > 0 ? (currentIndex/contacts.length)*100 : 0}%` }}></div>
                                </div>
                                <div className="grid grid-cols-2 gap-2">
                                    <button onClick={import200} className="bg-zinc-800 hover:bg-zinc-700 text-[9px] py-3 rounded-xl font-bold uppercase border border-zinc-700">Importar 200</button>
                                    <button onClick={clearContacts} className="bg-red-950/10 text-red-500 text-[9px] py-3 rounded-xl font-bold border border-red-900/20 hover:bg-red-900/30 transition-all">Limpiar</button>
                                </div>
                            </div>
                        </div>

                        {/* PANEL CENTRAL */}
                        <div className="lg:col-span-8 flex flex-col gap-6 overflow-hidden">
                            <div className="bg-zinc-900 p-8 rounded-[2.5rem] border border-zinc-800 shadow-2xl relative flex flex-col shrink-0">
                                {status === 'sending' && (
                                    <div className="absolute top-6 right-10 bg-emerald-600 px-6 py-2 rounded-full text-black text-xs font-black shadow-xl animate-pulse flex items-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="3" className="animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                                        SIGUIENTE: {Math.floor(timeLeft/60)}:{(timeLeft%60).toString().padStart(2,'0')}
                                    </div>
                                )}
                                <h3 className="text-white font-black mb-6 uppercase text-sm tracking-widest flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> Mensaje Universal (Apple / Android)
                                </h3>
                                
                                <select className="bg-black border border-emerald-900/20 rounded-xl p-3 text-[10px] font-bold text-emerald-500 outline-none mb-4 w-52 uppercase tracking-tighter" value={interval} onChange={e => setIntervalVal(Number(e.target.value))}>
                                    <option value={1}>1 Minuto de espera (Rápido)</option>
                                    <option value={2}>2 Minutos de espera (Seguro)</option>
                                    <option value={5}>5 Minutos (Máxima Seguridad)</option>
                                </select>

                                <textarea className="w-full h-44 bg-black border border-zinc-800 rounded-3xl p-6 text-emerald-400 outline-none focus:border-emerald-500 mb-6 resize-none text-xl leading-relaxed custom-scrollbar shadow-inner" placeholder="Redacta el mensaje masivo..." value={message} onChange={e => setMessage(e.target.value)} />
                                
                                <button onClick={() => setStatus(status === 'sending' ? 'idle' : 'sending')} disabled={contacts.length === 0 || !message} className={`w-full py-6 rounded-3xl font-black text-2xl flex items-center justify-center gap-4 transition-all shadow-2xl active:scale-[0.97] ${status === 'sending' ? 'bg-red-900/20 text-red-500 border border-red-900/50' : 'bg-emerald-600 text-black hover:bg-emerald-400 shadow-emerald-500/20'}`}>
                                    {status === 'sending' ? 'DETENER TRANSMISIÓN' : 'INICIAR BLAST MASIVO'}
                                </button>
                            </div>

                            <div className="bg-black p-6 rounded-[2rem] border border-emerald-900/10 flex-1 flex flex-col min-h-0 shadow-inner">
                                <span className="text-[9px] font-black text-emerald-900 uppercase tracking-[0.4em] mb-4 text-center">Monitor de Entrega Universal (Live)</span>
                                <div className="flex-1 overflow-y-auto custom-scrollbar space-y-1 text-xs font-mono">
                                    {logs.map(log => (
                                        <div key={log.id} className="flex justify-between border-b border-zinc-900/30 py-2 animate-in fade-in slide-in-from-left-2">
                                            <span className="text-emerald-950 font-bold w-20">[{log.time}]</span>
                                            <span className="text-zinc-500 flex-1 px-4 truncate tracking-tighter">{log.target}</span>
                                            <span className={`font-black tracking-tighter ${log.status === 'OK' || log.status === 'RECIBIDO' ? 'text-emerald-500 shadow-[0_0_8px_#10b981]' : 'text-red-800 uppercase'}`}>
                                                {log.status}
                                            </span>
                                        </div>
                                    ))}
                                    {logs.length === 0 && <div className="text-zinc-900 italic text-center pt-16 font-black uppercase text-[10px] tracking-widest opacity-20">Esperando órdenes de transmisión...</div>}
                                    <div ref={logEndRef} />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
